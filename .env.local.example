# ─── THE GRID — Environment Variables ───────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Production: APP_URL=https://yourdomain.com

# Minimum 32 random characters. Generate: openssl rand -base64 32
SESSION_SECRET=replace_with_32_plus_char_random_string_here

# Minimum 16 random characters. Generate: openssl rand -hex 16
CRON_SECRET=replace_with_16_plus_char_random_string

# Comma-separated bootstrap allowlists for persistent owner/admin roles.
ADMIN_EMAILS=owner@example.com
ADMIN_MEMBER_IDS=

# ── Wix (internal — never expose to users) ───────────────────────────────────
# Found in Wix Headless dashboard → Settings → OAuth Apps
WIX_CLIENT_ID=your_wix_oauth_client_id

# Found in Wix dashboard → Settings → API Keys
WIX_API_KEY=your_wix_api_key

# Found in Wix dashboard → Settings → General
WIX_SITE_ID=your_wix_site_id

# ── Wix API Endpoints (defaults are correct — only override if needed) ────────
# WIX_COUPONS_ENDPOINT=https://www.wixapis.com/stores/v2/coupons
# WIX_MEMBERS_ENDPOINT=https://www.wixapis.com/members/v1/members
# WIX_MEMBERS_QUERY_ENDPOINT=https://www.wixapis.com/members/v1/members/query
# WIX_CONTACTS_ENDPOINT=https://www.wixapis.com/contacts/v4/contacts
# WIX_ORDERS_SEARCH_ENDPOINT=https://www.wixapis.com/ecom/v1/orders/search

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Leave blank to use in-memory store (dev only — data resets on restart)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=the_grid

# ── Cookie ────────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=grid_session
OAUTH_COOKIE_NAME=grid_oauth
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.yourdomain.com   # Only needed for subdomain sharing

# ── Business Rules ────────────────────────────────────────────────────────────
WELCOME_BONUS_CREDITS=5000
BIRTHDAY_BONUS_CREDITS=5000
SYNC_STALE_HOURS=24
GRID_COUPON_SCOPE_NAMESPACE=stores

# ── Leaderboard cache TTL in milliseconds (default: 5 minutes) ───────────────
LEADERBOARD_CACHE_TTL_MS=300000
LEADERBOARD_SNAPSHOT_SIZE=500
REDEMPTION_IDEMPOTENCY_TTL_HOURS=24
FRAUD_HOLD_SCORE=80
